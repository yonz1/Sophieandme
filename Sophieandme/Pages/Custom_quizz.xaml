<Page
    x:Class="Sophieandme.Pages.Custom_quizz"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:Sophieandme.Pages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Custom_quizz"
    d:DesignHeight="740"
    d:DesignWidth="1280"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource main_background}"
            BorderThickness="2"
            CornerRadius="20">
            <DockPanel
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent">
                <RadioButton
                    x:Name="Create"
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Background="Transparent"
                    Click="Create_Click_1"
                    Content="Create"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Mathématiques" />
                <RadioButton
                    x:Name="custom_but"
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Background="Transparent"
                    Click="custom_but_Click"
                    Content="Created"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Physique" />
            </DockPanel>
        </Border>


        <!--  ################################################################################################################# Interface de création de quizz  -->

        <Grid
            x:Name="Create_grid"
            Grid.Row="1"
            Visibility="Collapsed">
            <DockPanel>
                <wv2:WebView2
                    x:Name="webviewall"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Source="file:///C:/Users/Bastien/source/repos/Sophieandme/Sophieandme/Math.html" />
            </DockPanel>
        </Grid>

        <!--  ################################################################################################################# Interface de choix de dossier et de quizz  -->

        <Grid
            x:Name="custom_folder_grid"
            Grid.Row="1"
            Visibility="Visible">
            <ScrollViewer
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="-10,0,10,0"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <DockPanel>
                        <DockPanel
                            x:Name="Return_panel"
                            Height="50"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed">
                            <Button
                                x:Name="return_btn"
                                Width="120"
                                Height="40"
                                HorizontalAlignment="Left"
                                Click="return_btn_Click"
                                DockPanel.Dock="Top"
                                Foreground="Gainsboro"
                                Style="{StaticResource MaterialDesignFlatButton}">
                                <StackPanel Orientation="Horizontal">
                                    <fs:IconImage
                                        Width="20"
                                        Height="20"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                        Icon="ArrowLeft" />
                                    <TextBlock
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Matières" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <WrapPanel
                            x:Name="Quizzcontain"
                            Grid.Row="1"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal" />
                        <wv2:WebView2
                            x:Name="webview_added"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="20"
                            DockPanel.Dock="Top"
                            Source="file:///C:/Users/Bastien/source/repos/Sophieandme/Sophieandme/Math.html"
                            Visibility="Collapsed" />
                    </DockPanel>
                </Grid>
            </ScrollViewer>

        </Grid>

        <!--  ################################################################################ Interface de quizz  -->
    </Grid>
</Page>
