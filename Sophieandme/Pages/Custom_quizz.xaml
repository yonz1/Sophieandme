<Page
    x:Class="Sophieandme.Pages.Custom_quizz"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:Sophieandme.Pages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Custom_quizz"
    d:DesignHeight="740"
    d:DesignWidth="1280"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Height="50"
            Margin="508,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{StaticResource main_background}"
            BorderThickness="2"
            CornerRadius="20">
            <DockPanel
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent">
                <RadioButton
                    x:Name="Create"
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Background="Transparent"
                    Click="Create_Click_1"
                    Content="Create"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Mathématiques" />
                <RadioButton
                    x:Name="custom_but"
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Background="Transparent"
                    Click="custom_but_Click"
                    Content="Dossier"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Physique" />

            </DockPanel>
        </Border>

        <Grid
            x:Name="Create_grid"
            Grid.Row="1"
            Visibility="Collapsed">
            <DockPanel>
                <wv2:WebView2
                    x:Name="webviewall"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="30,30,30,30"
                    Source="file:///C:/Users/Bastien/source/repos/Sophieandme/Sophieandme/Math.html" />
            </DockPanel>
        </Grid>



        <Grid
            x:Name="custom_folder_grid"
            Grid.Row="1"
            Visibility="Visible">
            <ScrollViewer
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="-10,0,10,0"
                VerticalScrollBarVisibility="Hidden">
                <WrapPanel
                    x:Name="Quizzcontain"
                    Grid.Row="1"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
