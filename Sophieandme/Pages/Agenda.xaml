<Page
    x:Class="Sophieandme.Pages.Agenda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sophieandme.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Agenda"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
                <ResourceDictionary Source="/Style/Calendar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Calendar
            Width="380"
            Height="345"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CalendarButtonStyle="{DynamicResource CalendarButtonStyle1}"
            CalendarDayButtonStyle="{DynamicResource CalendarDayButtonStyle1}"
            CalendarItemStyle="{DynamicResource CalendarItemStyle1}"
            Style="{DynamicResource CalendarStyle1}" />
    </Grid>
</Page>
