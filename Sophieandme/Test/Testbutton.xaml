<Page
    x:Class="Sophieandme.Test.Testbutton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:Sophieandme.Test"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Testbutton"
    d:DesignHeight="50"
    d:DesignWidth="200"
    mc:Ignorable="d">


    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Background="Black">
        <Label
            x:Name="Maths_btn"
            Margin="5,0,0,0"
            Padding="0,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            HorizontalContentAlignment="left"
            VerticalContentAlignment="Center"
            Background="Black"
            Content="Mathématiques"
            FontFamily="Sans Serif Collection"
            FontSize="6"
            Foreground="#E5FFFFFF" />
        <Rectangle
            Width="44"
            Height="3"
            Margin="5,29,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="White"
            Stroke="Black" />
        <fs:IconImage
            Width="30"
            Height="30"
            Margin="168,16,2,4"
            Icon="Superscript"
            Opacity="0.5"
            RenderTransformOrigin="0.5,0.5"
            Style="{StaticResource TopButtonIconrad}">
            <fs:IconImage.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="18.311" />
                    <TranslateTransform />
                </TransformGroup>
            </fs:IconImage.RenderTransform>
            <fs:IconImage.Foreground>
                <SolidColorBrush Opacity="1" Color="White" />
            </fs:IconImage.Foreground>
            <fs:IconImage.Effect>
                <DropShadowEffect
                    BlurRadius="100"
                    Direction="210"
                    Opacity="1"
                    ShadowDepth="0"
                    Color="#FF4252D8" />
            </fs:IconImage.Effect>
        </fs:IconImage>
    </Grid>
</Page>
